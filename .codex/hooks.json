{
  "description": "Capture user prompts and final assistant responses for the 8x assignment.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/capture_prompt.py",
            "command_windows": "py -3 .codex\\hooks\\capture_prompt.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/capture_stop.py",
            "command_windows": "py -3 .codex\\hooks\\capture_stop.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
